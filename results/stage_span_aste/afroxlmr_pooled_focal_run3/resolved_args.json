{
  "model_name": "Davlan/afro-xlmr-base",
  "train_path": "data/prepared_explicit/train.jsonl",
  "dev_path": "data/prepared_explicit/dev.jsonl",
  "test_path": "data/prepared_explicit/test.jsonl",
  "batch_size": 4,
  "epochs": 10,
  "lr_transformer": 5e-05,
  "lr_head": 0.001,
  "max_span_length": 8,
  "pruning_ratio": 0.5,
  "width_dim": 20,
  "distance_dim": 128,
  "hidden_dim": 150,
  "dropout": 0.4,
  "use_biaffine": true,
  "biaffine_dim": 256,
  "use_span_sync": true,
  "use_span_mean_pooling": true,
  "use_focal_loss": false,
  "focal_gamma": 2.0,
  "relation_loss_weights": [
    0.1,
    1.0,
    1.0,
    2.0
  ]
}